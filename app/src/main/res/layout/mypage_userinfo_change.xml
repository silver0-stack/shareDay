<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#ffffff"
        android:elevation="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:text="회원정보수정"
            />
        <ImageButton
            android:id="@+id/mypage_userinfochange_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="#00000000"
            android:scaleType="centerCrop"
            android:src="@drawable/back_icon"/>
        <ImageButton
            android:id="@+id/mypage_userinfochange_alarm"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="right"
            android:layout_marginRight="30dp"
            android:background="#00000000"
            android:scaleType="centerCrop"
            android:src="@drawable/alarm_black_icon"/>

    </androidx.appcompat.widget.Toolbar>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이메일"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="14dp"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="24dp"
        />

    <EditText
        android:background="@drawable/edittext_bg"
        android:layout_width="364dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"
        android:hint="이메일을 입력하세요"
        android:paddingStart="15dp"
        android:textSize="15dp"
        android:inputType="textEmailAddress"
        android:textColorHint="#A6A6A6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이름"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="14dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="24dp"
        />

    <EditText
        android:id="@+id/userId"
        android:background="@drawable/edittext_bg"
        android:layout_width="364dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"
        android:hint="새로운 닉네임을 입력해주세요"
        android:textSize="15dp"
        android:paddingStart="15dp"
        android:inputType="textEmailAddress"
        android:textColorHint="#A6A6A6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="새 비밀번호"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="14dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="24dp"
        />

    <EditText
        android:background="@drawable/edittext_bg"
        android:layout_width="364dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"
        android:hint="새로운 비밀번호를 입력해주세요"
        android:textSize="15dp"
        android:paddingStart="15dp"
        android:inputType="textEmailAddress"
        android:textColorHint="#A6A6A6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="새 비밀번호 확인"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="14dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="24dp"
        />
    <EditText
        android:background="@drawable/edittext_bg"
        android:layout_width="364dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"
        android:hint="새로운 비밀번호를 한번 더 입력해주세요"
        android:textSize="15dp"
        android:paddingStart="15dp"
        android:inputType="textEmailAddress"
        android:textColorHint="#A6A6A6" />

    <Button
        android:id="@+id/userInfo_change_Btn"
        android:layout_width="364dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:backgroundTint="#7D2F85"
        android:text="확   인"
        android:textStyle="bold"
        android:textSize="18sp" />




</LinearLayout>