<?xml version="1.0" encoding="utf-8"?><!-- 마이페이지 화면 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.MyPageFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="210dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/mypage_background"
            android:orientation="horizontal"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:id="@+id/navigationBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/myPageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="168dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="마이페이지"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <ImageView
                    android:id="@+id/alarmIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="100dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/alarm_icon" />
            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/myPhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="100dp"
                android:scaleType="fitXY"
                android:src="@drawable/profile1_image" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/myPhotoChange"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="170dp"
                android:src="@drawable/mypage_photochage_icon"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="슈니슈니"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="138dp"
                tools:layout_editor_absoluteY="227dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/mypage_bigcrown_icon"/>

            <TextView
                android:id="@+id/helpScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="도움지수 20P"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="20dp"
                android:src="@drawable/mypage_point_icon"
                android:layout_marginLeft="80dp"
                />

            <TextView
                android:id="@+id/pointScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="포인트 39P"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/helpHistoryBtn"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:backgroundTint="#7D2F85"
                android:textStyle="bold"
                android:text="도움 내역" />

            <Button
                android:id="@+id/useHistoryBtn"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:layout_marginLeft="30dp"
                android:backgroundTint="#882489"
                android:textStyle="bold"
                android:text="사용 내역" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#8E6D91"
                android:layout_gravity="center"/>
            <Button
                style="@style/Widget.AppCompat.Button.Borderless"
                android:id="@+id/userInfoModification"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/white"
                android:drawableLeft="@drawable/left_modification"
                android:text="개인 정보 수정"
                android:textAlignment="viewStart"
                android:textColor="@color/black" />


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#AEA6AF"
                android:layout_gravity="center"/>
            <Button
                style="@style/Widget.AppCompat.Button.Borderless"
                android:id="@+id/myWriting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/white"
                android:drawableLeft="@drawable/left_mywriting"
                android:text="내가 쓴 글"
                android:textAlignment="viewStart"
                android:textColor="@color/black" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#AEA6AF"
                android:layout_gravity="center"/>

            <Button
                style="@style/Widget.AppCompat.Button.Borderless"
                android:id="@+id/settings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/white"
                android:drawableLeft="@drawable/left_setting"
                android:text="공지사항"
                android:textAlignment="viewStart"
                android:textColor="@color/black" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#AEA6AF"
                android:layout_gravity="center"/>

            <Button
                style="@style/Widget.AppCompat.Button.Borderless"
                android:id="@+id/help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/white"
                android:drawableLeft="@drawable/left_info"
                android:text="도움말"
                android:textAlignment="viewStart"
                android:textColor="@color/black" />
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#8E6D91"
                android:layout_gravity="center"/>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>