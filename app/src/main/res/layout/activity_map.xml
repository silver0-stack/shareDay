<?xml version="1.0" encoding="utf-8"?><!--지도화면 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".mapmenu.MapActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/myArea"
            android:layout_width="350dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="화랑로 621"
            android:paddingStart="50dp"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/alarmIcon"
            style="?android:borderlessButtonStyle"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:src="@drawable/alarm_icon"
            app:tint="@color/black" />


    </LinearLayout>

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="600dp">

    <com.naver.maps.map.MapView
        android:id="@+id/map_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="5" />

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="350dp"
        android:layout_marginTop="30dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/findLocation"
            android:src="@drawable/map_findlocation_button_icon"
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <ImageView
            android:id="@+id/toilet"
            android:src="@drawable/map_restroom_button_icon"
            android:layout_width="match_parent"
            android:layout_height="40dp" />
        <ImageView
            android:id="@+id/helpMeIcon"
            android:src="@drawable/map_helpme_button_icon"
            android:layout_width="match_parent"
            android:layout_height="40dp" />
        <ImageView
            android:id="@+id/helpYouIcon"
            android:src="@drawable/map_helpyou_button_icon"
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>

</FrameLayout>

</LinearLayout>
